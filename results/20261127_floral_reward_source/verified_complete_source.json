    "lines": [
      "Pollen.by.family.mean=aggregate(Pollen.production3, log10Pollen~Family, FUN=mean)",
      "Pollen.by.family.SE=aggregate(Pollen.production3, log10Pollen~Family, FUN=std.error)",
      "model3 = pglmm(log10Pollen ~ Tube_length * Symmetry + (1 | Species__ ),",
      "model3.1 = pglmm(log10Pollen ~ Symmetry + (1 | Species__ ),",
      "model3.2 = pglmm(log10Pollen ~ Tube_length + (1 | Species__ ),",
      "model3.3 = pglmm(log10Pollen ~ Tube_length + Symmetry + (1 | Species),",
      "fit.yx<-gls(Nectar.microg.per.day~log10Pollen,data=Nectar.and.pollen,",
      "model7=lmer(log10Pollen ~ 1|Family/Genus, data=Pollen.production3)",
      "labs(x = \"Log10 daily sugar production (microgram)\", y = \"Number of records\")",
      "ggplot(Pollen.production2, aes(x=log10Pollen, fill=Symmetry)) +",
      "labs(x = \"Log10 pollen production\", y = \"Number of records\")",
      "labs(x = \"Tube length (mm)\", y = \"Daily sugar production (microgram/flower)\") +"
    ]
